# ─── ENVIRONMENT & SECRETS (CRITICAL) ─────────────────────
# Contains Supabase URLs, anon keys, OpenRouter keys, Gemini keys.
# The .env.example template IS safe to commit.
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
!.env.example

# ─── DEPENDENCIES ─────────────────────────────────────────
node_modules/

# ─── EXPO ─────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ─── NATIVE BUILD OUTPUT ─────────────────────────────────
/ios/
/android/
.kotlin/
*.orig.*

# ─── EAS BUILD ────────────────────────────────────────────
*.tar.gz
*.ipa
*.apk
*.aab

# ─── APPLE DEVELOPER CERTIFICATES & SIGNING ─────────────
*.p8
*.p12
*.cer
*.key
*.pem
*.mobileprovision
*.provisionprofile
AuthKey_*.p8

# ─── ANDROID KEYSTORE & SIGNING ──────────────────────────
*.jks
*.keystore
google-services.json

# ─── METRO BUNDLER ────────────────────────────────────────
.metro-health-check*

# ─── SUPABASE LOCAL DEV ──────────────────────────────────
# Contains project-ref, pooler-url, and other local identifiers.
supabase/.temp/
supabase/.branches/

# ─── DEBUG LOGS ──────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
*.log.*

# ─── TYPESCRIPT ──────────────────────────────────────────
*.tsbuildinfo

# ─── OS FILES ────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
ehthumbs.db

# ─── IDE / EDITOR ────────────────────────────────────────
