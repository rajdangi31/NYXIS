# ═══════════════════════════════════════════════════════════
#  NYXIS — Environment Variables
# ═══════════════════════════════════════════════════════════
#
#  SETUP:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in your own values below.
#    3. NEVER commit .env to version control.
#
# ═══════════════════════════════════════════════════════════

# ─── SUPABASE (Required) ─────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI / OPENROUTER (Server-Side Only) ──────────────────
# This key is NOT used in the mobile app.
# It must be set as a Supabase Edge Function secret:
#   npx supabase secrets set OPENROUTER_API_KEY=sk-or-xxxxxxxx
#
# Get your key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ─── OPTIONAL / FUTURE INTEGRATIONS ─────────────────────
# GITHUB_TOKEN=          (for Reality Anchor verification)
# FITBIT_CLIENT_ID=      (for fitness data integration)
# FITBIT_CLIENT_SECRET=  (for fitness data integration)
